{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "license": "${mod_license}",
  "icon": "${mod_logo_file}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_display_url}",
    "issues": "${mod_issue_tracker_url}",
    "sources": "${mod_sources_url}"
  },
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.p3pp3rf1y.sophisticatedcore.SophisticatedCore"
    ],
    "client": [
      "net.p3pp3rf1y.sophisticatedcore.client.ClientEventHandler"
    ],
    "jei_mod_plugin": [
      "net.p3pp3rf1y.sophisticatedcore.compat.recipeviewers.jei.CoreJeiPlugin"
    ]
  },
  "mixins": [
    "sophisticatedcore.mixins.json"
  ],
  "accessWidener": "sophisticatedcore.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=25",
    "fabric-api": ">=${fabric_api_version}",
    "forgeconfigapiport": ">=${forge_config_api_port_version}"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "badges": [
        "library"
      ],
      "parent": {
        "id": "sophisticatedmods",
        "name": "Sophisticated Mods",
        "description": "Group of P3pp3rF1y's Sophisticated Mods"
      }
    },
    "loom:injected_interfaces": {
      "net/minecraft/world/item/component/ItemContainerContents": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/item/component/SophisticatedItemContainerContents"
      ],
      "net/minecraft/world/inventory/Slot": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/inventory/SophisticatedSlot"
      ],
      "net/minecraft/world/item/Item": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/item/SophisticatedItem"
      ],
      "net/minecraft/world/level/material/Fluid": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/level/material/SophisticatedFluid"
      ],
      "net/minecraft/client/gui/screens/Screen": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/client/gui/screens/SophisticatedScreen"
      ],
      "net/minecraft/world/level/Level": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/level/SophisticatedLevel"
      ],
      "net/minecraft/world/level/block/entity/BlockEntity": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/block/entity/SophisticatedBlockEntity"
      ],
      "net/minecraft/world/entity/Entity": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/entity/SophisticatedEntity"
      ],
      "net/minecraft/world/item/ItemStack": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/item/SophisticatedItemStack"
      ],
      "net/minecraft/world/item/crafting/RecipeManager": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/item/crafting/SophisticatedRecipeManager"
      ],
      "net/minecraft/client/gui/screens/inventory/AbstractContainerScreen": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/client/gui/screens/inventory/SophisticatedAbstractContainerScreen"
      ],
      "net/minecraft/client/KeyMapping": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/client/SophisticatedKeyMapping"
      ]
    }
  }
}
